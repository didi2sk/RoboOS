  (text "RoboOS IoT shield THT v0.1 - FIRST DRAFT, not built or tested. Through-hole parts only."
    (at 280 245 0)
    (effects
      (font (size 1.5 1.5))
      (justify left bottom))
    (uuid "48861e62-e8ce-5010-a632-7b1e00ba9081"))
  (text "GPIO: IN1-4 = GPIO17/27/22/5 (low = input on), relays K1/K2 = GPIO24/25, MOSFETs = GPIO12/16,"
    (at 280 250 0)
    (effects
      (font (size 1.5 1.5))
      (justify left bottom))
    (uuid "5d3542f6-088c-5241-b6d9-35fd058f0f3d"))
  (text "status LED GPIO23, button GPIO6 (low = pressed), I2C GPIO2/3: ADS1115 module 0x48, DS3231 module 0x68."
    (at 280 255 0)
    (effects
      (font (size 1.5 1.5))
      (justify left bottom))
    (uuid "6b26cf85-e756-5db2-ac3f-412f0ac3237c"))
  (text "5 V goes to the Pi pins 2/4: do not power the Pi from its USB port at the same time. Max input 28 V."
    (at 280 260 0)
    (effects
      (font (size 1.5 1.5))
      (justify left bottom))
    (uuid "2853fb1d-7dcb-5fdb-80a5-77604d7eda12"))
  (text "Relay contacts: low voltage only (max 24 V, 5 A) - not for 230 V."
    (at 280 265 0)
    (effects
      (font (size 1.5 1.5))
      (justify left bottom))
    (uuid "b454eebc-3f79-50c5-9659-aba90110e621"))
